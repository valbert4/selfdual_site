    given-names: "Victor V."
  - family-names: Barg
    given-names: Alexander
keywords:
  - coding theory
  - self-dual codes
  - Type II codes
  - error-correcting codes
  - "[72,36,16]"
  - extremal codes
repository-code: "https://github.com/REPLACE-ME/extremal72"
url: "https://REPLACE-ME.github.io/extremal72/"
